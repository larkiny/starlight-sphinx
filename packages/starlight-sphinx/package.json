{
  "name": "starlight-sphinx",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Starlight plugin to generate documentation from Python packages using Sphinx autodoc2.",
  "author": "HiDeoo <github@hideoo.dev> (https://hideoo.dev)",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "pnpm test:unit",
    "test:unit": "vitest",
    "lint": "eslint . --cache --max-warnings=0"
  },
  "dependencies": {
    "github-slugger": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.68",
    "typescript": "^5.7.2",
    "vitest": "2.1.6"
  },
  "peerDependencies": {
    "@astrojs/starlight": ">=0.32.0"
  },
  "engines": {
    "node": ">=18.17.1"
  },
  "packageManager": "pnpm@8.6.1",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "keywords": [
    "starlight",
    "plugin",
    "sphinx",
    "python",
    "documentation",
    "astro",
    "autodoc2"
  ]
}
